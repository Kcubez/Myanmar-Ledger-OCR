# Comma-separated Gemini API keys. Never prefix this name with NEXT_PUBLIC_.
GEMINI_API_KEYS=your-first-key,your-second-key

# Supabase Postgres — pooler (6543) for app, direct (5432) for migrations.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Supabase Storage (service role — server-only). Create a private `ledger-images` bucket once.
SUPABASE_URL="https://..."
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram bot (server-only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Better Auth
BETTER_AUTH_SECRET="your-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Email OTP (Brevo)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Ledger Bot"

# App (public)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ledger Dashboard"
